{
  "name": "codex-cli-app-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "codex-cli": "bin/codex-cli",
    "cdx": "bin/codex-cli",
    "hiai": "bin/hiai",
    "cpb-paste": "bin/cpb-paste"
  },
  "scripts": {
    "check": "node --check bin/codex-cli && node --check bin/cpb-paste",
    "test": "npm run check && node --test tests/*.test.mjs",
    "test:attack": "node tests/run-attack.mjs",
    "test:parity": "node --check tests/parity.mjs && CODEX_PARITY=1 node --test tests/parity.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=bin/codex-cli --test-coverage-include=bin/cpb-paste --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=80 --test tests/*.test.mjs",
    "help": "node bin/codex-cli --help"
  }
}
